# ETH all-5 day-1 live environment (example)
# Purpose:
# - first live launch across all 5 venues
# - minimal funded capital (~100 USDC/USDT per venue)
# - keep the existing ETH micro-canary profile
# - tighten the daily USD loss stop materially below the conservative default
#
# Copy real values into /etc/paraphina/current.env or a promoted env file.
# Do not commit secrets.

PARAPHINA_TRADE_MODE=live
PARAPHINA_RISK_PROFILE=conservative
PARAPHINA_DAILY_LOSS_LIMIT=5
PARAPHINA_MM_EDGE_LOCAL_MIN=0.10
# Venue-specific edge hardening for the next economic canary:
# - Hyperliquid was active but still produced zero fills across the stable canary.
# - Extended remained the noisiest venue for spread blowouts and rejects.
# - Paradex was thinner but still contributed positive fill flow.
PARAPHINA_MM_EDGE_LOCAL_MIN_HYPERLIQUID=0.18
PARAPHINA_MM_EDGE_LOCAL_MIN_EXTENDED=0.45
PARAPHINA_MM_EDGE_LOCAL_MIN_EXTENDED_ASK=0.60
PARAPHINA_MM_EDGE_LOCAL_MIN_PARADEX=0.18
PARAPHINA_MM_LAMBDA_INV=0.80
PARAPHINA_MM_MIN_QUOTE_LIFETIME_MS=1500
PARAPHINA_MM_MIN_QUOTE_LIFETIME_MS_HYPERLIQUID=3000
PARAPHINA_MM_MIN_QUOTE_LIFETIME_MS_EXTENDED=3000
PARAPHINA_MM_PRICE_TOL_TICKS=2.0
PARAPHINA_MM_PRICE_TOL_TICKS_HYPERLIQUID=4.0
PARAPHINA_MM_PRICE_TOL_TICKS_EXTENDED=4.0
PARAPHINA_MM_SIZE_TOL_REL=0.25
PARAPHINA_MM_SIZE_TOL_REL_HYPERLIQUID=0.35
PARAPHINA_MM_SIZE_TOL_REL_EXTENDED=0.35
PARAPHINA_MM_VENUE_ROLE_HYPERLIQUID=anchor
PARAPHINA_MM_VENUE_ROLE_LIGHTER=fill
PARAPHINA_MM_VENUE_ROLE_EXTENDED=noise
PARAPHINA_MM_VENUE_ROLE_ASTER=fill
PARAPHINA_MM_VENUE_ROLE_PARADEX=anchor
PARAPHINA_MM_PRE_SOFT_TAPER_GLOBAL_POS_TAO_ASTER=0.010
PARAPHINA_MM_PRE_SOFT_TAPER_VENUE_POS_TAO_ASTER=0.0075
PARAPHINA_MM_PRE_SOFT_TAPER_SIZE_MULT_ASTER=0.50
PARAPHINA_MM_MAX_QUOTE_SPREAD_USD_EXTENDED=3.0
PARAPHINA_MM_MAX_QUOTE_SPREAD_BPS_EXTENDED=15
PARAPHINA_CANARY_INVENTORY_BRAKE_FRACTION=0.75
PARAPHINA_CANARY_INVENTORY_BRAKE_NET_FRACTION=0.75
PARAPHINA_CANARY_INVENTORY_BRAKE_GROSS_FRACTION=0.75
PARAPHINA_CANARY_INVENTORY_BRAKE_VENUE_FRACTION=0.75
PARAPHINA_CANARY_BRAKE_UNWIND_SLIPPAGE_BPS=50
PARAPHINA_CANARY_BRAKE_UNWIND_SLIPPAGE_BPS_LIGHTER=75
PARAPHINA_CANARY_BRAKE_UNWIND_SLIPPAGE_BPS_PARADEX=75
PARAPHINA_CANARY_BRAKE_GRACE_MS=1500
PARAPHINA_CANARY_BRAKE_GRACE_TICKS=3
PARAPHINA_CANARY_BRAKE_GRACE_EXCESS_FRACTION=0.10
PARAPHINA_CANARY_STARTUP_PNL_BASELINE_GUARD=1
PARAPHINA_CANARY_STARTUP_PNL_LIMIT_USD=1.0
PARAPHINA_CANARY_STARTUP_POSITION_TAO_TOL=0.0025
PARAPHINA_CANARY_STARTUP_PNL_MAX_WAIT_TICKS=40
PARAPHINA_CANARY_SOFT_UNWIND_TIMEOUT_BACKOFF_MS=1500
PARAPHINA_CANARY_LIGHTER_EMERGENCY_LATCH_MS=3000
PARAPHINA_CANARY_LIGHTER_EMERGENCY_MAX_LATCH_MS=9000
PARAPHINA_LIVE_ACCOUNT_POLL_MS=1000
PARAPHINA_LIGHTER_ACCOUNT_POLL_MS=3000
PARAPHINA_HEDGE_BAND_BASE=0.03
PARAPHINA_HEDGE_MAX_STEP=0.05
PARAPHINA_HEDGE_DISABLED_VENUES=paradex
PARAPHINA_TELEMETRY_APPEND=1

PARAPHINA_LIVE_CONNECTORS=hyperliquid,lighter,extended,aster,paradex
PARAPHINA_LIVE_OUT_DIR=/var/lib/paraphina/out
PARAPHINA_TELEMETRY_MODE=jsonl
PARAPHINA_TELEMETRY_PATH=/var/lib/paraphina/out/telemetry.jsonl
PARAPHINA_LIVE_METRICS_ADDR=127.0.0.1:9898
PARAPHINA_PARADEX_PUBLIC_FEED=orderbook

# Reconciliation is mandatory in live mode.
PARAPHINA_LIVE_ACCOUNT_RECONCILE_MS=5000
PARAPHINA_RECONCILE_POS_TAO_TOL=0.01
PARAPHINA_RECONCILE_POS_SOFT_KILL_STREAK=4
PARAPHINA_RECONCILE_POS_KILL_EXEMPT_VENUES=
PARAPHINA_RECONCILE_BALANCE_USD_TOL=1.0
PARAPHINA_RECONCILE_ORDER_COUNT_TOL=0

# Day-1 ETH micro-canary profile.
PARAPHINA_LIVE_CANARY_PROFILE=configs/prod_canary_eth_recover.toml

# Venue state staleness overrides validated in shadow.
PARAPHINA_HL_STATE_STALE_MS_OVERRIDE=1500
PARAPHINA_EXTENDED_STATE_STALE_MS_OVERRIDE=1500
PARAPHINA_PARADEX_STATE_STALE_MS_OVERRIDE=3000

# Live execution guardrails.
# Leave these disabled until preflight passes.
PARAPHINA_LIVE_EXEC_ENABLE=0
PARAPHINA_LIVE_EXECUTION_CONFIRM=NO
# PARAPHINA_LIVE_PREFLIGHT_OK=1

# Connector execution mode safety.
HL_PAPER_MODE=false
LIGHTER_PAPER_MODE=false

# ETH market selection.
HL_COIN=ETH
LIGHTER_MARKET=ETH-USD
EXTENDED_MARKET=ETH-USD
EXTENDED_REST_URL=https://api.starknet.extended.exchange
EXTENDED_FUNDING_PATH=/api/v1/info/markets/ETH-USD/stats
ASTER_MARKET=ETHUSDT
PARADEX_MARKET=ETH-USD-PERP

# Hyperliquid
HL_NETWORK=mainnet
HL_PRIVATE_KEY=0xc94b38d1b9284050bfe64a42853679b1dd9bc295fc713359400e16680a9c3fff
HL_VAULT_ADDRESS=0x1Fda48711A56534bd3C685D13D81905a0fb9F17a

# Lighter
LIGHTER_NETWORK=mainnet
LIGHTER_API_KEY_INDEX=2
LIGHTER_ACCOUNT_INDEX=718392
LIGHTER_API_PRIVATE_KEY_HEX=1b4cc9d987e1c53b62bf231efcac57a7957897e7fb86a6895c1e311ac00c23467765bc66f3da3f0a
LIGHTER_SIGNER_URL=http://127.0.0.1:9001
# Optional:
# LIGHTER_AUTH_TOKEN=<redacted>
# LIGHTER_NONCE_PATH=/var/lib/paraphina/lighter_nonce.json

# Extended
EXTENDED_API_KEY=81340f9b58362b018ab06b65360bf71c
EXTENDED_TRADER_CMD="/opt/paraphina/.venv_extended/bin/python3 /opt/paraphina/tools/extended_trade.py"
# Extended live auth is SDK-backed: the helper script signs Starknet payloads
# using the official x10-python-trading-starknet SDK.
EXTENDED_STARK_PRIVATE_KEY=0x7d7da3d6297ceb7e6b4ec485851482632fe3ac753f02e9842c38c880965f3a4
EXTENDED_STARK_PUBLIC_KEY=0x1e09a903629025bd5a0a4e761f0c188b3de68a1898ed5b2ab7f36cf7b376036
EXTENDED_L2_VAULT=357266
# Optional metadata from Extended tooling:
# EXTENDED_ACCOUNT_ID=<redacted>
# Optional helper override:
# EXTENDED_SDK_ENV=mainnet

# Aster
ASTER_API_KEY=efb1d84ba4a2039d6e4378cf7a467d2cd695585104b1ad9e07a680e472002c79
ASTER_API_SECRET=d16a9a36e3f4478bc75823d6995e43764b5ff9c28763fd787132f9436946b8b2

# Paradex
PARADEX_JWT_CMD="/opt/paraphina/.venv_paradex/bin/python3 /opt/paraphina/tools/paradex_jwt.py"
PARADEX_L2_ADDRESS=0x1766f424cfbfa56c6879f6e20618c038de7abcd86eaf55c7ebd0943880a7553
PARADEX_L2_PRIVATE_KEY=0x5a58c4d144f49cba49463db96735f8847758479350afeaf6f38daf55d1a9178
PARADEX_PY_ENV=prod
# PARADEX_JWT=<redacted>
# PARADEX_AUTH_PAYLOAD_JSON={"address":"...","signature":"..."}
PARAPHINA_LIVE_PREFLIGHT_OK=1
PARADEX_SIGN_ORDER_CMD=/opt/paraphina/.venv_paradex/bin/python3 /opt/paraphina/tools/paradex_sign_order.py
