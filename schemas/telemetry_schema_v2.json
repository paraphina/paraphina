{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paraphina Phase 5.1 Telemetry Event Schema v2",
  "description": "Schema for Phase 5.1 non-live EV/replay/shadow telemetry events. v2 is selected per JSONL file by schema_version.",
  "type": "object",
  "schema_version": 2,
  "required_fields": [
    "schema_version",
    "event_type",
    "event_seq",
    "timestamp_local_ns",
    "run_id",
    "baseline_commit",
    "no_live_flag"
  ],
  "optional_fields": [
    "candidate_id",
    "venue_id",
    "side",
    "layer",
    "decision",
    "decision_reason_primary",
    "local_edge_feature",
    "pair_edge_feature",
    "selected_size_Q",
    "P_fill_hat",
    "P_fill_ci_low",
    "P_fill_ci_high",
    "P_hedge_success_hat",
    "P_hedge_partial_hat",
    "P_hedge_fail_hat",
    "E_locked_edge_hat",
    "E_partial_hedge_state_hat",
    "E_residual_inventory_state_hat",
    "E_adverse_selection_hat",
    "E_queue_reset_hat",
    "E_churn_hat",
    "E_capital_funding_hat",
    "E_tail_risk_hat",
    "EV_hat",
    "EV_standard_error",
    "EV_lcb_alpha",
    "alpha",
    "admissible_for_financial_claim"
  ],
  "field_types": {
    "schema_version": "integer",
    "event_type": "string",
    "event_seq": "integer",
    "timestamp_local_ns": "integer",
    "run_id": "string",
    "baseline_commit": "string",
    "no_live_flag": "boolean",
    "candidate_id": "string",
    "venue_id": "string",
    "side": "string",
    "layer": "string",
    "decision": "string",
    "decision_reason_primary": "string",
    "local_edge_feature": "number",
    "pair_edge_feature": ["number", "null"],
    "selected_size_Q": "number",
    "P_fill_hat": "number",
    "P_fill_ci_low": "number",
    "P_fill_ci_high": "number",
    "P_hedge_success_hat": "number",
    "P_hedge_partial_hat": "number",
    "P_hedge_fail_hat": "number",
    "E_locked_edge_hat": "number",
    "E_partial_hedge_state_hat": "number",
    "E_residual_inventory_state_hat": "number",
    "E_adverse_selection_hat": "number",
    "E_queue_reset_hat": "number",
    "E_churn_hat": "number",
    "E_capital_funding_hat": "number",
    "E_tail_risk_hat": "number",
    "EV_hat": "number",
    "EV_standard_error": "number",
    "EV_lcb_alpha": "number",
    "alpha": "number",
    "admissible_for_financial_claim": "boolean"
  },
  "enums": {
    "event_type": [
      "V2_RUN_CONTEXT",
      "V2_MARKET_SNAPSHOT",
      "V2_PAIR_EDGE_SNAPSHOT",
      "V2_EV_EVALUATED",
      "V2_ORDER_INTENT",
      "V2_ORDER_LIFECYCLE",
      "V2_FILL_OBSERVED",
      "V2_FAST_HEDGE_DECISION",
      "V2_HEDGE_LIFECYCLE",
      "V2_INVENTORY_SNAPSHOT",
      "V2_BALANCE_SNAPSHOT",
      "V2_REPLAY_LABEL",
      "V2_GUARDRAIL_EVENT"
    ],
    "decision": ["ADMIT", "REJECT", "HOLD"]
  },
  "invariants": {
    "schema_version_value": 2,
    "t_monotonic": true,
    "numerics_finite": true
  }
}
