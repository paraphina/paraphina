# Rust / Cargo build artefacts
/target/
/.cargo-target/

# Python virtual environment
.venv/

# Core tick logs
paraphina_ticks.jsonl
paraphina_ticks.log

# Old one-off research harness outputs
research_run_*.jsonl
research_run_*_curve.png

# Batch-run helper outputs
# Keep batch_runs for generated artifacts, but TRACK Python code under batch_runs/.
# (Git requires parent directories to be unignored for file exceptions to work.)
batch_runs/**
!batch_runs/
!batch_runs/**/
!batch_runs/**/*.py
!batch_runs/**/*.md

# Paraphina research artefacts
# (all .jsonl here are tick logs / experiment logs, not configs)
runs/
*.jsonl

# Generic experiment CSV / PNG outputs (exp01, exp02, exp03, exp04, ...)
# e.g. exp01_band_sweep_summary.csv, exp02_hedge_band_heatmap_pnl.png, ...
exp[0-9][0-9]_*.csv
exp[0-9][0-9]_*.png

# Per-run plots from research_ticks.py etc.
*_pnl_curve.png
*_delta_curve.png
*_basis_curve.png
*_heatmap_pnl.png

# Raw grid outputs that can always be regenerated
exp0*_runs.csv

# Baseline study artefacts
baseline_q0_band5*.png
baseline_q0_band5*.jsonl

# Python caches
__pycache__/
*.py[cod]

paraphina_bundle.txt
paraphina_context.tar.gz
paraphina_context.tar.gz.part_*


# Local context bundles
paraphina_bundle.txt
paraphina_context.tar.gz
paraphina_context.tar.gz.part_*

# Local context bundles
paraphina_bundle.txt
paraphina_context.tar.gz
paraphina_context.tar.gz.part_*

# sim_eval generated outputs
_reports/
reports/

# generated research reports
_reports/

# allow fixture jsonl files (needed for CI tests)
!tests/fixtures/**/*.jsonl
live_audit/

# Shadow / live run output artifacts
out/

# Phase 5 repo hygiene
# Keep curated queue/status/control and final closeout evidence in Git, but do
# not track orchestration sessions, lane worktrees, duplicated overlays, or raw
# run output copied from promotion runs.
phase5/orchestration.yaml
phase5/runs/**
!phase5/runs/
!phase5/runs/README.md
!phase5/runs/phase5_reopened_final_closeout/
!phase5/runs/phase5_reopened_final_closeout/**
!phase5/runs/phase5_reopened_wallet_econ_full_cost_opportunity_adjusted_gate_requal/
!phase5/runs/phase5_reopened_wallet_econ_full_cost_opportunity_adjusted_gate_requal/**
phase5/runs/**/lanes/
phase5/runs/**/overlay/
phase5/runs/**/queue_preview.yaml
phase5/runs/**/tranche_card_preview.yaml

# Historical/local Phase 5 investigation notes are kept out of the production
# cloneable closeout baseline unless explicitly promoted into docs.
docs/INVESTIGATIONS/phase5_*_202604*.md
docs/INVESTIGATIONS/phase5_balance_baseline_*.yaml
